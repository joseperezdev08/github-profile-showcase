{
  "name": "github-profile-showcase",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo con una API NestJS y una interfaz SSR en Next.js para mostrar un perfil de GitHub.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @github-profile/api --filter @github-profile/web dev",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --filter @github-profile/api test",
    "test:e2e": "pnpm --filter @github-profile/api test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm build && pnpm format:check"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
